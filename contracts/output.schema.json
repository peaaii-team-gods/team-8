{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized pipeline output",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "rows", "row_count", "total"],
  "properties": {
    "schema_version": {"const": "output.v1"},
    "rows": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sensor_id", "reading", "doubled"],
        "properties": {
          "sensor_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
          "reading": {"type": "integer", "minimum": 0, "maximum": 999999},
          "doubled": {"type": "integer", "minimum": 0, "maximum": 1999998}
        }
      }
    },
    "row_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "total": {"type": "integer", "minimum": 0, "maximum": 31999968}
  }
}
