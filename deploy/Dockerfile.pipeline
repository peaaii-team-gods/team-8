# Local hospital pipeline server for the compose network.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --system --uid 10001 --home /app --shell /usr/sbin/nologin pipeline \
    && mkdir -p /app/data
COPY . .
RUN chown -R 10001:10001 /app
USER 10001
CMD ["python", "-u", "server/pipeline_server.py"]
