# Local hospital pipeline server for the compose network.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
ENV PIPELINE_HOST=0.0.0.0 \
    PIPELINE_PORT=8787 \
    PIPELINE_REQUIRE_AUTH=1
CMD ["python", "-u", "server/pipeline_server.py"]
